PROMETHEUS_URL=http://prometheus-smokeping:9090
PROBER_RELOAD_URL=http://smokeping-prober:9374/-/reload
CONFIG_PATH=/config/config.yaml
BACKUP_DIR=/config/backups
METRIC_WINDOW=5m

WARNING_LOSS_PERCENT=5
CRITICAL_LOSS_PERCENT=20
DOWN_LOSS_PERCENT=99.9

# Se true, restaura o YAML anterior quando o reload falhar.
RELOAD_REQUIRED=false

# Preencha para ativar HTTP Basic Auth. Também pode proteger pelo Traefik.
MANAGER_USERNAME=admin
MANAGER_PASSWORD=troque-esta-senha

# Descubra no host com: id -u && id -g
PUID=1000
PGID=1000
