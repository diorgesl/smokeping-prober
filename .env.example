# Env compartilhado pelos 3 serviços (smokeping-prober, alert-engine, manager).
# Copie para .env e preencha os valores reais.

# Conectividade
DOMINIO=example.com
GRAFANA_DASHBOARD_URL=https://grafana.${DOMINIO}/d/qFUCgeXuww/smokeping?orgId=1
PROMETHEUS_URL=http://prometheus-smokeping:9090
TELEGRAM_BOT_TOKEN=123456789:substitua-pelo-token
TELEGRAM_CHAT_ID=-1001234567890
TZ=America/Campo_Grande
PROBER_RELOAD_URL=http://smokeping-prober:9374/-/reload
CONFIG_PATH=/config/config.yaml
BACKUP_DIR=/config/backups
METRIC_WINDOW=5m

# Operação segura: deixe true no primeiro teste; depois altere para false.
DRY_RUN=true
LOG_LEVEL=INFO
DATABASE_PATH=/data/alerts.db

# Avaliação: 1 ping/s, janela de 5m ~= 300 pings.
EVALUATION_INTERVAL_SECONDS=60
QUERY_WINDOW=${METRIC_WINDOW}
MIN_SAMPLES=240
ALERT_CONFIRMATIONS=3
RECOVERY_CONFIRMATIONS=3

# Perda
LOSS_THRESHOLD_PERCENT=5
RECOVERY_LOSS_PERCENT=2
LOSS_AGGRAVATION_STEP_PERCENT=5
WARNING_LOSS_PERCENT=5
CRITICAL_LOSS_PERCENT=20
DOWN_LOSS_PERCENT=99.9

# Latência: os dois limites precisam ser atingidos.
LATENCY_INCREASE_MS=10
LATENCY_INCREASE_PERCENT=25
BASELINE_ALPHA=0.05
BASELINE_MIN_EVALUATIONS=5

# Jitter
JITTER_INCREASE_MS=5
JITTER_INCREASE_PERCENT=50

# Mensagens
GROUP_ALERT_THRESHOLD=3
REMINDERS_ENABLED=true

# Diagnóstico MTR
MTR_ENABLED=true
MTR_CYCLES=10
MTR_TIMEOUT_SECONDS=90
MTR_COOLDOWN_SECONDS=900

# Se true, restaura o YAML anterior quando o reload falhar.
RELOAD_REQUIRED=false

# Preencha para ativar HTTP Basic Auth no manager. Também pode proteger pelo Traefik.
MANAGER_USERNAME=admin
MANAGER_PASSWORD=troque-esta-senha

# Descubra no host com: id -u && id -g
PUID=1000
PGID=1000
