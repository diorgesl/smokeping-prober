{
  "annotations": [
    {
      "kind": "AnnotationQuery",
      "spec": {
        "builtIn": true,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "query": {
          "datasource": {
            "name": "grafana"
          },
          "group": "grafana",
          "kind": "DataQuery",
          "spec": {
            "limit": 100,
            "matchAny": false,
            "tags": [],
            "type": "dashboard"
          },
          "version": "v0"
        }
      }
    }
  ],
  "cursorSync": "Crosshair",
  "description": "Smoke Ping using https://github.com/SuperQ/smokeping_prober\r\nwith \r\nlatency heatmap\r\nlatency graph per uplink (link label)\r\npacket loss graph per uplink\r\nremote collection health\r\n",
  "editable": true,
  "elements": {
    "panel-2": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "afwcksz8b71tse"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "sum(rate(smokeping_response_duration_seconds_bucket{category=\"$categoria\",title=\"${target:raw}\",link=~\"$link\"}[5m])) by (le)",
                      "format": "heatmap",
                      "intervalFactor": 1,
                      "legendFormat": "{{le}}",
                      "range": true
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Distribuição de latência dos links selecionados na variável link.",
        "id": 2,
        "links": [],
        "title": "Smoke Ping - $target",
        "vizConfig": {
          "group": "heatmap",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "custom": {
                  "hideFrom": {
                    "legend": false,
                    "tooltip": false,
                    "viz": false
                  },
                  "scaleDistribution": {
                    "type": "linear"
                  }
                }
              },
              "overrides": []
            },
            "options": {
              "annotations": {
                "clustering": -1,
                "multiLane": false
              },
              "calculate": false,
              "calculation": {},
              "cellGap": 2,
              "cellValues": {},
              "color": {
                "exponent": 0.5,
                "fill": "#FF9830",
                "max": 1,
                "min": 0,
                "mode": "opacity",
                "reverse": false,
                "scale": "exponential",
                "scheme": "Oranges",
                "steps": 128
              },
              "exemplars": {
                "color": "rgba(255,0,255,0.7)"
              },
              "filterValues": {
                "le": 1e-9
              },
              "legend": {
                "show": false
              },
              "rowsFrame": {
                "layout": "auto"
              },
              "showValue": "never",
              "tooltip": {
                "mode": "single",
                "showColorScale": false,
                "yHistogram": false
              },
              "yAxis": {
                "axisPlacement": "left",
                "decimals": 0,
                "min": "0",
                "reverse": false,
                "unit": "s"
              }
            }
          },
          "version": "13.1.3"
        }
      }
    },
    "panel-4": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "afwcksz8b71tse"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "label_replace(1 - (sum by (link) (increase(smokeping_response_duration_seconds_count{category=\"$categoria\",title=\"${target:raw}\",link=~\"$link\"}[5m])) / sum by (link) (increase(smokeping_requests_total{category=\"$categoria\",title=\"${target:raw}\",link=~\"$link\"}[5m]))), \"link\", \"local\", \"link\", \"^$\")",
                      "legendFormat": "{{link}}",
                      "range": true
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              },
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "afwcksz8b71tse"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "expr": "label_replace(sum by (link) (increase(smokeping_requests_total{category=\"$categoria\",title=\"${target:raw}\",link=~\"$link\"}[5m])) - sum by (link) (increase(smokeping_response_duration_seconds_count{category=\"$categoria\",title=\"${target:raw}\",link=~\"$link\"}[5m])), \"link\", \"local\", \"link\", \"^$\")",
                      "legendFormat": "{{link}} perdidos",
                      "range": true
                    },
                    "version": "v0"
                  },
                  "refId": "B"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Perda de pacotes por link nos últimos 5 minutos. A linha tracejada é o número de pacotes perdidos na janela. Falhas do prober (SSH, timeout, parse) não aparecem aqui; veja Saúde da coleta remota.",
        "id": 4,
        "links": [],
        "title": "Packet Loss por link - $target",
        "vizConfig": {
          "group": "timeseries",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "palette-classic"
                },
                "custom": {
                  "axisBorderShow": false,
                  "axisCenteredZero": false,
                  "axisColorMode": "text",
                  "axisLabel": "Loss %",
                  "axisPlacement": "auto",
                  "barAlignment": 0,
                  "barWidthFactor": 0.6,
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "gradientMode": "none",
                  "hideFrom": {
                    "legend": false,
                    "tooltip": false,
                    "viz": false
                  },
                  "insertNulls": false,
                  "lineInterpolation": "linear",
                  "lineWidth": 1,
                  "pointSize": 5,
                  "scaleDistribution": {
                    "type": "linear"
                  },
                  "showPoints": "never",
                  "showValues": false,
                  "spanNulls": false,
                  "stacking": {
                    "group": "A",
                    "mode": "none"
                  },
                  "thresholdsStyle": {
                    "mode": "off"
                  }
                },
                "min": 0,
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                },
                "unit": "percentunit"
              },
              "overrides": [
                {
                  "matcher": {
                    "id": "byRegexp",
                    "options": ".* perdidos$"
                  },
                  "properties": [
                    {
                      "id": "custom.fillOpacity",
                      "value": 0
                    },
                    {
                      "id": "unit",
                      "value": "none"
                    },
                    {
                      "id": "decimals",
                      "value": 0
                    },
                    {
                      "id": "custom.axisLabel",
                      "value": "Pacotes perdidos"
                    },
                    {
                      "id": "custom.lineStyle",
                      "value": {
                        "dash": [
                          10,
                          10
                        ],
                        "fill": "dash"
                      }
                    }
                  ]
                }
              ]
            },
            "options": {
              "annotations": {
                "clustering": -1,
                "multiLane": false
              },
              "legend": {
                "calcs": [
                  "mean",
                  "max",
                  "lastNotNull"
                ],
                "displayMode": "table",
                "enableFacetedFilter": false,
                "overflow": "ellipsis",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": {
                "hideZeros": false,
                "mode": "multi",
                "sort": "desc"
              }
            }
          },
          "version": "13.1.3"
        }
      }
    },
