# Conectividade
PROMETHEUS_URL=http://prometheus-smokeping:9090
TELEGRAM_BOT_TOKEN=123456789:substitua-pelo-token
TELEGRAM_CHAT_ID=-1001234567890
TZ=America/Campo_Grande

# Operação segura: deixe true no primeiro teste; depois altere para false.
DRY_RUN=true
LOG_LEVEL=INFO
DATABASE_PATH=/data/alerts.db

# Avaliação: 1 ping/s, janela de 5m ~= 300 pings.
EVALUATION_INTERVAL_SECONDS=60
QUERY_WINDOW=5m
MIN_SAMPLES=240
ALERT_CONFIRMATIONS=3
RECOVERY_CONFIRMATIONS=3

# Perda
LOSS_THRESHOLD_PERCENT=5
RECOVERY_LOSS_PERCENT=2
LOSS_AGGRAVATION_STEP_PERCENT=5

# Latência: os dois limites precisam ser atingidos.
LATENCY_INCREASE_MS=10
LATENCY_INCREASE_PERCENT=25
BASELINE_ALPHA=0.05
BASELINE_MIN_EVALUATIONS=5

# Mensagens
GROUP_ALERT_THRESHOLD=3
REMINDERS_ENABLED=true

# Diagnóstico MTR
MTR_ENABLED=true
MTR_CYCLES=10
MTR_TIMEOUT_SECONDS=90
MTR_COOLDOWN_SECONDS=900

